# Application
# ENVIRONMENT: development | production
ENVIRONMENT=development
PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=boilerplate
# DB_SSLMODE: disable | require | verify-ca | verify-full (defaults to 'disable' in development, 'require' in production)
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=gin-boilerplate-super-secure-jwt-secret-key-32-bytes!
JWT_EXPIRATION_MINUTES=10
REFRESH_EXPIRATION_MINUTES=1440

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gin-boilerplate@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Gin Boilerplate <gin-boilerplate@example.com>" 

# Docker
FORWARD_DB_PORT=5438

# Initial Admin Seeder
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Change@123"